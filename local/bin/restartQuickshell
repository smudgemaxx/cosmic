#!/usr/bin/env bash
# Restart the Quickshell daemon (replaces restartWaybar).

if pgrep -x quickshell >/dev/null; then
  pkill -x quickshell
  # Give the old instance time to release its layer surfaces / IPC socket.
  for _ in $(seq 1 20); do
    pgrep -x quickshell >/dev/null || break
    sleep 0.1
  done
fi

setsid quickshell >/dev/null 2>&1 < /dev/null &
